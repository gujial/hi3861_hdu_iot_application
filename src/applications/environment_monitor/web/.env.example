# Copy to .env. Never commit real credentials. Server reads .env at startup.
HOST=127.0.0.1
PORT=8787
# Generate with: node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=
API_PROXY_TARGET=http://127.0.0.1:8787
DB_PATH=data/environment.sqlite
STATIC_DIR=dist/client
POLL_SECONDS=10
STALE_SECONDS=90

# Verified against the user-provided cn-east-3 instance (2026-09-06).
IOTDA_ENDPOINT=https://abcaf9a974.st1.iotda-app.cn-east-3.myhuaweicloud.com
IOTDA_INSTANCE_ID=a5ead6e5-eb88-42d6-a0da-969aeffff187
# IAM project ID is NOT the IoTDA instance ID or resource-space/app ID.
IOTDA_PROJECT_ID=
IOTDA_DEVICE_ID=
IOTDA_SERVICE_ID=Environment
IOTDA_TEMPERATURE_PROPERTY=temperature
IOTDA_HUMIDITY_PROPERTY=humidity
IOTDA_GAS_PROPERTY=gas_resistance

# Option A: short-lived scoped IAM token; restart after replacing an expired token.
IOTDA_AUTH_TOKEN=
# Option B: IAM user credentials; backend obtains and renews scoped tokens.
IAM_ENDPOINT=https://iam.cn-east-3.myhuaweicloud.com
IAM_DOMAIN=
IAM_USERNAME=
IAM_PASSWORD=

# ntfy URL is the server origin, NOT the topic URL. Topic is configured separately.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
