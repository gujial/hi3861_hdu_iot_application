declare_args() {
    environment_cloud_enabled = false
}

static_library("environment_monitor_device") {
    sources = [
        "aht20.c",
        "environment_monitor.c",
        "oled_ssd1306.c",
    ]

    if (environment_cloud_enabled) {
        sources += [ "environment_cloud.c", "environment_time.c" ]
        defines = [ "ENVIRONMENT_CLOUD_ENABLED" ]
    }
    include_dirs = [
        "//foundation/communication/wifi_lite/interfaces/wifiservice",
        "//device/hisilicon/hispark_pegasus/sdk_liteos/third_party/paho.mqtt.c/include/mqtt",
        "//utils/native/lite/include",
        "//kernel/liteos_m/kal",
        "//base/iot_hardware/peripheral/interfaces/kits",
        "//device/hisilicon/hispark_pegasus/sdk_liteos/include"
    ]
}
