# Source a private copy before running configure_device.py; keep it outside Git.
export ENV_WIFI_SSID=''
export ENV_WIFI_PASSWORD=''
export ENV_MQTT_URI='ssl://abcaf9a974.st1.iotda-device.cn-east-3.myhuaweicloud.com:8883'
export ENV_DEVICE_ID=''
# Use the MQTT client ID / derived password from the IoTDA MQTT credential tool.
# MQTT password is NOT the unprocessed device secret.
export ENV_MQTT_CLIENT_ID=''
export ENV_MQTT_PASSWORD=''
export ENV_MQTT_CA_FILE=''
export ENV_SERVICE_ID='Environment'
export ENV_REPORT_INTERVAL_SECONDS=30
export ENV_NTP_SERVER='time.pool.aliyun.com'
# Local alarm limits. Enable gas alarm only after warming up and calibrating the sensor.
export ENV_LOCAL_TEMP_LOW=0
export ENV_LOCAL_TEMP_HIGH=35
export ENV_LOCAL_HUMIDITY_LOW=20
export ENV_LOCAL_HUMIDITY_HIGH=50
export ENV_LOCAL_GAS_ALARM_ENABLED=0
export ENV_LOCAL_GAS_LOW=0
export ENV_LOCAL_GAS_HIGH=100
